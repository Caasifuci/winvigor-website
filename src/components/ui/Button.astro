---
/**
 * Button: renders <a> when given href, otherwise <button>.
 * primary   → the accent; at most one per view.
 * secondary → ink outline.
 * quiet     → underlined text action.
 * `inverse` adapts secondary/quiet for ink surfaces.
 */
import type { HTMLAttributes } from 'astro/types';

type Common = {
  variant?: 'primary' | 'secondary' | 'quiet';
  size?: 'md' | 'lg';
  inverse?: boolean;
};
type Props = Common & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'href'>)
  | ({ href?: undefined } & HTMLAttributes<'button'>)
);

const { variant = 'primary', size = 'md', inverse = false, href, class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, { 'btn--inverse': inverse }, className];
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}><slot /></a>
) : (
  <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}><slot /></button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 2.875rem;
    padding: 0.75rem 1.375rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: 550;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .btn--lg { min-height: 3.25rem; padding: 0.9rem 1.75rem; font-size: 1rem; }

  .btn--primary { background: var(--accent); color: var(--ink); }
  .btn--primary:hover { background: var(--ink); color: var(--paper); }
  .btn--inverse.btn--primary:hover { background: var(--paper); color: var(--ink); }

  .btn--secondary { border-color: var(--ink); color: var(--ink); background: transparent; }
  .btn--secondary:hover { background: var(--ink); color: var(--paper); }
  .btn--inverse.btn--secondary { border-color: var(--on-ink); color: var(--paper); }
  .btn--inverse.btn--secondary:hover { background: var(--paper); color: var(--ink); }

  .btn--quiet {
    min-height: auto;
    padding: 0.25rem 0;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .btn--quiet:hover { text-decoration-color: currentColor; }
  .btn--inverse.btn--quiet { color: var(--paper); }
</style>
