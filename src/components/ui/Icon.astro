---
/**
 * Icon: simple 24px line icons, drawn in currentColor so they follow the
 * surrounding text (white on dark teal, teal or blue on light surfaces).
 */
export type IconName =
  | 'strategy' | 'code' | 'people' | 'shield' | 'search' | 'chat'
  | 'check' | 'arrow' | 'globe' | 'briefcase' | 'clock' | 'mail'
  | 'phone' | 'pin' | 'layers' | 'handshake' | 'chart' | 'doc' | 'cookie';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  strategy: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/><path d="m4 7 6-3 6 6 5-4"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  people: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 5.2a3 3 0 0 1 0 5.6M21 20c0-2.6-1.6-4.8-4-5.6"/>',
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>',
  chat: '<path d="M20 12.5c0 3.6-3.6 6.5-8 6.5-1.1 0-2.2-.2-3.2-.5L4 20l1.3-3.6C4.5 15.3 4 14 4 12.5 4 8.9 7.6 6 12 6s8 2.9 8 6.5Z"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5S9.7 5.9 12 3.5Z"/>',
  briefcase: '<rect x="3.5" y="7" width="17" height="12" rx="1.5"/><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3.5 12.5h17"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 7 8 6 8-6"/>',
  phone: '<path d="M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 5.2 5.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  layers: '<path d="m12 3.5 8.5 4.5-8.5 4.5L3.5 8 12 3.5Z"/><path d="m3.5 12 8.5 4.5 8.5-4.5M3.5 16l8.5 4.5 8.5-4.5"/>',
  handshake: '<path d="m11 6.5-1.5-1L6 6.5 3 10l5.5 6 1.5 1.5a1.4 1.4 0 0 0 2-2l1 1a1.4 1.4 0 0 0 2-2l1 .9a1.4 1.4 0 0 0 2-2L21 10l-3-3.5-3.5-1-3.5 2.5-1.5 1.5a1.4 1.4 0 0 0 2 2L14 9"/>',
  chart: '<path d="M4 4v16h16"/><path d="m7.5 15 3.5-4 3 2.5 5-6"/>',
  cookie: '<path d="M20.5 12.5A8.5 8.5 0 1 1 11.5 3.5a3 3 0 0 0 3.5 3.5 3 3 0 0 0 3.5 3.5 2.2 2.2 0 0 0 2 2Z"/><circle cx="8.5" cy="10" r=".9" fill="currentColor"/><circle cx="12.5" cy="14.5" r=".9" fill="currentColor"/><circle cx="8" cy="15.5" r=".9" fill="currentColor"/><circle cx="15.5" cy="11.5" r=".6" fill="currentColor"/>',
  doc: '<path d="M7 3.5h7l4 4v13H7a1.5 1.5 0 0 1-1.5-1.5V5A1.5 1.5 0 0 1 7 3.5Z"/><path d="M14 3.5V8h4M9 12h6M9 15.5h6"/>',
};
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
