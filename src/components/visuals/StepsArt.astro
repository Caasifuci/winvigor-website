---
/**
 * StepsArt (careers): a stair of slanted bars on a grid. A career path,
 * drawn with the same primitive as the mark. Accent on the next step.
 */
import { bar, gridLines } from './geometry';

const W = 620, H = 520, BASE = 450;
const steps = [70, 130, 190, 250, 310];
const grid = gridLines(W, H, 40);
---

<svg class="art" viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" focusable="false">
  <g class="grid">
    {grid.h.map((y) => <line x1="0" y1={y} x2={W} y2={y} />)}
  </g>
  {steps.map((h, i) => (
    <path class:list={['step', i === steps.length - 1 ? 'step--next' : i % 2 ? 'step--ink' : 'step--slate']} d={bar(40 + i * 84, BASE, 64, h)} />
  ))}
  <line class="base" x1="24" y1={BASE} x2={W - 24} y2={BASE} />
</svg>

<style>
  .grid line { stroke: var(--rule); stroke-width: 1; opacity: 0.7; }
  .base { stroke: var(--ink); stroke-width: 1.5; }
  .step--ink { fill: var(--ink); }
  .step--slate { fill: var(--slate); }
  .step--next { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 7 6; }
</style>
