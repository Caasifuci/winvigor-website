---
/**
 * NumberedSteps: a short run of numbered steps in columns
 * ("Future-proof your workforce in 3 steps" on Huxley).
 */
interface Props {
  steps: { title: string; body?: string }[];
  inverse?: boolean;
  label?: string;
}

const { steps, inverse = false, label } = Astro.props;
---

<ol class:list={['nsteps', { 'nsteps--inverse': inverse }]} style={`--n: ${steps.length}`} aria-label={label}>
  {steps.map((s, i) => (
    <li class="nstep">
      <span class="nstep__num" aria-hidden="true">{i + 1}</span>
      <h3 class="nstep__title">{s.title}</h3>
      {s.body && <p class="nstep__body">{s.body}</p>}
    </li>
  ))}
</ol>

<style>
  .nsteps { display: grid; gap: var(--space-6); margin: 0; padding: 0; list-style: none; counter-reset: none; }
  .nstep { display: grid; gap: var(--space-3); align-content: start; }
  .nstep__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .nstep__title { font-family: var(--display); letter-spacing: var(--display-tracking); font-size: var(--step-1); font-weight: var(--display-weight-small); line-height: 1.25; color: var(--ink); }
  .nstep__body { color: var(--slate); line-height: 1.6; }

  .nsteps--inverse .nstep__num { background: var(--accent); }
  .nsteps--inverse .nstep__title { color: var(--paper); }
  .nsteps--inverse .nstep__body { color: var(--mist); }

  @media (min-width: 48rem) {
    .nsteps { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2.5rem); }
    .nstep { padding-top: var(--space-2); }
  }
</style>
