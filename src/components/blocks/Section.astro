---
/**
 * Section: heading row with an optional "View all" link on the right, then
 * the content full width. The knowledge-hub and employer layouts are built
 * from these.
 */
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title?: string;
  intro?: string;
  id?: string;
  surface?: 'paper' | 'fog' | 'ink';
  viewAll?: { label: string; href: string };
  /** Tighter vertical padding. */
  compact?: boolean;
}

const { title, intro, id, surface = 'paper', viewAll, compact = false } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section id={id} class:list={['section', `section--${surface}`, { 'section--compact': compact }]} aria-labelledby={title ? headingId : undefined}>
  <Container>
    {(title || viewAll) && (
      <header class="section__head">
        <div class="section__heading">
          {title && <h2 class="section__title" id={headingId}>{title}</h2>}
          {intro && <p class="section__intro">{intro}</p>}
        </div>
        {viewAll && (
          <a class="section__all" href={viewAll.href}>
            {viewAll.label}<Icon name="arrow" size={18} />
          </a>
        )}
      </header>
    )}
    <slot />
  </Container>
</section>

<style>
  .section { padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem); }
  .section--compact { padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .section--paper { background: var(--paper); }
  .section--fog { background: var(--fog); }
  .section--ink { background: var(--ink); color: var(--on-ink); }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: clamp(1.75rem, 1rem + 2vw, 2.75rem);
  }
  .section__heading { display: grid; gap: var(--space-4); max-width: 46rem; }
  .section__title {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: var(--step-3);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }
  .section--ink .section__title { color: var(--paper); }
  .section__intro { font-size: var(--step-0); line-height: 1.6; color: var(--slate); text-wrap: pretty; }
  .section--ink .section__intro { color: var(--mist); }

  .section__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--accent-strong);
    text-decoration: none;
  }
  .section__all:hover { text-decoration: underline; text-underline-offset: 0.25em; }
  .section--ink .section__all { color: var(--accent-on-ink); }
</style>
