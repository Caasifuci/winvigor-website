---
/**
 * PageHero: the full-width page header used across the redesigned pages.
 *
 * tone="dark"  → dark teal-blue band (employer pattern, home hero), white text, accent button
 * tone="light" → cool-grey band (knowledge-hub pattern)
 *
 * Optional: `features` renders a row of icon items under the copy (as on
 * Huxley's employer page); the "visual" slot takes drawn artwork; the
 * "footer" slot sits under the hero (client list).
 */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Ambient from '@/components/motion/Ambient.astro';

type Cta = { label: string; href: string };
export type Feature = { icon: IconName; title: string; body?: string; href?: string };

interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
  primary?: Cta;
  secondary?: Cta;
  tone?: 'dark' | 'light';
  features?: Feature[];
  scale?: 'home' | 'page';
  /** "center" stacks everything on the centre line (home banner). */
  align?: 'start' | 'center';
  /** Render the title as an uppercase banner, one line per entry. */
  banner?: string[];
}

const { title, lede, eyebrow, primary, secondary, tone = 'light', features = [], scale = 'page', align = 'start', banner } = Astro.props;
const dark = tone === 'dark';
const hasVisual = Astro.slots.has('visual');
---

<section class:list={['phero', `phero--${tone}`, `phero--${scale}`, `phero--${align}`, { 'phero--visual': hasVisual }]}>
  {dark && <Ambient constellation seed={scale === 'home' ? 3 : title.length} />}
  <Container grid class="phero__grid">
    <div class="phero__copy">
      {eyebrow && <p class="phero__eyebrow">{eyebrow}</p>}
      {banner ? (
        <h1 class="phero__title phero__title--banner">
          {banner.map((line) => <span class="phero__banner-line">{line}</span>)}
        </h1>
      ) : (
        <h1 class="phero__title">{title}</h1>
      )}
      {lede && <p class="phero__lede">{lede}</p>}
      {(primary || secondary) && (
        <div class="phero__actions" data-reveal="fade" style="--d: 480ms">
          {primary && <Button href={primary.href} variant="primary" size="lg" inverse={dark}>{primary.label}</Button>}
          {secondary && <Button href={secondary.href} variant="secondary" size="lg" inverse={dark}>{secondary.label}</Button>}
        </div>
      )}
    </div>
    {hasVisual && (
      <div class="phero__visual" aria-hidden="true"><slot name="visual" /></div>
    )}
  </Container>

  {features.length > 0 && (
    <Container class="phero__features-wrap">
      <ul role="list" class="phero__features" style={`--n: ${features.length}`}>
        {features.map((f, i) => {
          const Tag = f.href ? 'a' : 'div';
          return (
            <li data-reveal="fade" style={`--d: ${560 + i * 90}ms`}>
              <Tag class="feature" href={f.href}>
                <span class="feature__icon"><Icon name={f.icon} size={28} /></span>
                <span class="feature__text">
                  <span class="feature__title">{f.title}</span>
                  {f.body && <span class="feature__body">{f.body}</span>}
                </span>
              </Tag>
            </li>
          );
        })}
      </ul>
    </Container>
  )}

  {Astro.slots.has('footer') && (
    <Container class="phero__footer"><slot name="footer" /></Container>
  )}
</section>

<style>
  .phero { padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .phero--light { background: var(--fog); border-bottom: 1px solid var(--rule); }
  .phero--dark { position: relative; isolation: isolate; background: var(--ink); color: var(--on-ink); }
  .phero--dark > :global(:not(.ambient)) { position: relative; z-index: 1; }

  :global(.phero__grid) { row-gap: var(--space-7); align-items: center; }
  .phero__copy { grid-column: 1 / -1; }
  .phero__eyebrow {
    margin-bottom: var(--space-4);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .phero--dark .phero__eyebrow { color: var(--accent-on-ink); }

  .phero__title {
    font-family: var(--display);
    font-size: var(--step-4);
    font-weight: var(--display-weight);
    line-height: 1.06;
    letter-spacing: var(--display-tracking);
    color: var(--ink);
    text-wrap: balance;
  }
  .phero--home .phero__title { font-size: var(--step-5); }
  /* The heading is the page's largest element, so it paints at once (fast
     Largest Contentful Paint) and only rises into place: no fade, no script. */
  :global(.motion) .phero__title,
  :global(.motion) .phero__lede { animation: phero-rise var(--dur-reveal) var(--ease-out-expo) both; }
  :global(.motion) .phero__lede { animation-delay: 120ms; }
  @keyframes phero-rise { from { transform: translate3d(0, 0.4em, 0); } to { transform: none; } }
  .phero--dark .phero__title { color: var(--paper); }

  .phero__lede {
    margin-top: var(--space-6);
    max-width: 40rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--slate);
    text-wrap: pretty;
  }
  .phero--dark .phero__lede { color: var(--on-ink); }

  /* Centred banner: one statement per line, light uppercase, wide tracking. */
  .phero--center :global(.phero__grid) { justify-items: center; }
  .phero--center .phero__copy { grid-column: 1 / -1; display: grid; justify-items: center; text-align: center; }
  .phero--center .phero__lede { margin-inline: auto; }
  .phero--center .phero__actions { justify-content: center; }
  .phero .phero__title--banner {
    display: grid;
    gap: 0.5em;
    font-size: clamp(1.375rem, 0.9rem + 1.8vw, 2.375rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: var(--display-tracking-wide);
    text-transform: uppercase;
    /* tracking adds space after the last letter too; pull it back so lines stay centred */
    margin-right: calc(-1 * var(--display-tracking-wide));
  }
  .phero__banner-line { display: block; }
  /* Centred layout: artwork sits under the banner, on the same centre line. */
  .phero--center .phero__visual { grid-column: 1 / -1; justify-self: center; width: min(78%, 22rem); margin-top: var(--space-2); }
  @media (min-width: 64rem) {
    /* Artwork to the right of the banner; banner stays centred in its column. */
    .phero--center.phero--visual .phero__copy { grid-column: 1 / span 8; }
    .phero--center.phero--visual .phero__visual { grid-column: 9 / -1; width: 100%; max-width: 26rem; margin-top: 0; }
    /* Each statement stays on one line beside the artwork. */
    .phero--center.phero--visual .phero__title--banner { font-size: clamp(1.375rem, 0.5rem + 1.3vw, 1.875rem); white-space: nowrap; }
    .phero--center.phero--visual .phero__lede { font-size: var(--step-0); max-width: 34rem; }
  }
  @media (max-width: 40rem) {
    .phero .phero__title--banner { letter-spacing: 0.08em; margin-right: -0.08em; }
    .phero--center .phero__lede { font-size: var(--step-0); }
  }
  .phero--home.phero--center { padding-block: clamp(4.5rem, 3rem + 7vw, 9rem) clamp(3.5rem, 2.5rem + 4vw, 6rem); }

  .phero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-7); }

  .phero__visual { grid-column: 1 / -1; max-width: 30rem; width: 100%; justify-self: center; }
  .phero__visual :global(svg) { width: 100%; height: auto; }

  :global(.phero__features-wrap) { margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .phero__features {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .phero--dark .feature { background: var(--ink-2); border-color: var(--ink-line); color: var(--paper); }
  a.feature { transition: border-color var(--dur-fast) var(--ease-standard), transform var(--dur-base) var(--ease-out-expo); }
  a.feature:hover { border-color: var(--accent); transform: translate3d(0, -2px, 0); }
  @media (prefers-reduced-motion: reduce) { a.feature:hover { transform: none; } }
  .feature__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .phero--dark .feature__icon { background: rgb(143 179 255 / 0.16); color: var(--accent-on-ink); }
  .feature__text { display: grid; gap: var(--space-1); }
  .feature__title { font-weight: 600; line-height: 1.35; }
  .feature__body { font-size: 0.9375rem; line-height: 1.5; color: var(--slate); }
  .phero--dark .feature__body { color: var(--mist); }

  :global(.phero__footer) { margin-top: clamp(3rem, 2rem + 3vw, 5rem); }

  /* Drawings and the client list, recoloured for the dark teal band. */
  .phero--dark .phero__visual :global(.art__grid line) { stroke: var(--ink-line); opacity: 1; }
  .phero--dark .phero__visual :global(.tone--ink) { fill: var(--on-ink); }
  .phero--dark .phero__visual :global(.tone--slate) { fill: var(--mist); }
  .phero--dark .phero__visual :global(.art__base),
  .phero--dark .phero__visual :global(.art__trend) { stroke: var(--on-ink); }
  .phero--dark .phero__visual :global(.art__node) { fill: var(--ink); stroke: var(--on-ink); }
  .phero--dark .phero__visual :global(.tie) { stroke: var(--mist); }
  .phero--dark .phero__visual :global(.plane) { stroke: var(--on-ink); }
  .phero--dark .phero__visual :global(.plane--low) { fill: var(--ink-2); }
  .phero--dark .phero__visual :global(.plane--mid) { fill: var(--ink-line); }
  .phero--dark .phero__visual :global(.plane--top) { fill: var(--on-ink); }
  .phero--dark :global(.clients) { border-top-color: var(--ink-line); }
  .phero--dark :global(.clients__title) { color: var(--mist); }
  .phero--dark :global(.clients__name) { color: var(--on-ink); }

  @media (min-width: 48rem) {
    .phero__features { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .phero__copy { grid-column: 1 / span 8; }
    .phero--visual .phero__copy { grid-column: 1 / span 7; }
    .phero__visual { grid-column: 8 / -1; max-width: none; }
  }
</style>
