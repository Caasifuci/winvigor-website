---
/**
 * What we do, on the knowledge-hub pattern: hero → featured banner (talent)
 * → service cards → each service in detail → related case studies → help.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import FeatureBanner from '@/components/blocks/FeatureBanner.astro';
import Section from '@/components/blocks/Section.astro';
import CardGrid from '@/components/blocks/CardGrid.astro';
import SplitRows from '@/components/blocks/SplitRows.astro';
import HelpCta from '@/components/blocks/HelpCta.astro';
import { services } from '@/data/site';
import { caseStudyCards, getCaseStudies, getTalent, availability } from '@/lib/content';

const caseStudies = await getCaseStudies();
const cases = await caseStudyCards();
const talent = await getTalent();
const availableNow = talent.filter((t) => availability(t.data.availableFrom).now).length;

const relatedFor = (title: string) =>
  caseStudies.find((c) => c.data.services.some((s) => s.toLowerCase() === title.toLowerCase()));

const serviceCards = services.map((s, i) => ({
  href: `#${s.id}`,
  title: s.title,
  tag: 'Service',
  summary: s.summary,
  seed: 3 + i * 2,
}));

const artFor = ['systems', 'layers', 'roster', 'steps'] as const;
const rows = services.map((s, i) => {
  const related = relatedFor(s.title);
  return {
    id: s.id,
    title: s.title,
    body: `${s.summary} ${s.detail}`,
    link: related
      ? { label: 'Read the related case study', href: `/case-studies/${related.id}` }
      : { label: 'Talk to us about this', href: '/contact' },
    art: artFor[i % artFor.length],
  };
});
---

<BaseLayout title="What we do" description="Strategic IT consulting, custom software development, resource augmentation and operational risk management for EU institutions and enterprises.">
  <PageHero
    tone="dark"
    eyebrow="What we do"
    title="Strategy, engineering and talent under one engagement."
    lede="Four services, combined to fit the programme. Clients engage us for one or for all four; in either case one team is accountable for the outcome."
    primary={{ label: 'Discuss your programme', href: '/contact' }}
  />

  {talent.length > 0 && (
    <FeatureBanner
      title="Need specialists now? The talent board shows who can start."
      body="Anonymised profiles of engineers, analysts and delivery leads, for contract or permanent placement."
      action={{ label: 'See available engineers', href: '/talent' }}
      figure={String(availableNow)}
      figureLabel="engineers available now"
      seed={9}
    />
  )}

  <Section id="services" title="Our services" intro="Choose one service or combine them; the same team stays accountable for the result.">
    <CardGrid items={serviceCards} columns={4} label="Services" reveal />
  </Section>

  <Section id="detail" title="How each service works" surface="fog">
    <SplitRows rows={rows} />
  </Section>

  {cases.length > 0 && (
    <Section id="work" title="Related work" viewAll={{ label: 'All case studies', href: '/case-studies' }}>
      <CardGrid items={cases} label="Case studies" />
    </Section>
  )}

  <HelpCta title="Not sure which service fits?" />
</BaseLayout>
