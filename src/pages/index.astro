---
/**
 * Home, on the knowledge-hub pattern: hero → featured banner → card grids
 * (services, selected work, latest insights) → evidence band → talent →
 * "How can we help?".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import FeatureBanner from '@/components/blocks/FeatureBanner.astro';
import Section from '@/components/blocks/Section.astro';
import CardGrid from '@/components/blocks/CardGrid.astro';
import MetricGrid from '@/components/blocks/MetricGrid.astro';
import DeliveryLog from '@/components/blocks/DeliveryLog.astro';
import TalentBoard from '@/components/blocks/TalentBoard.astro';
import HelpCta from '@/components/blocks/HelpCta.astro';
import ClientLogos from '@/components/blocks/ClientLogos.astro';
import Typography from '@/components/ui/Typography.astro';
import { services } from '@/data/site';
import { caseStudyCards, getLog, getTalent, availability, insightCards } from '@/lib/content';

const talent = await getTalent();
const availableNow = talent.filter((t) => availability(t.data.availableFrom).now).length;
// Only real entries are shown; sample entries stay hidden until replaced.
const logEntries = (await getLog()).filter((e) => !e.data.sample).map((e) => e.data);
const work = (await caseStudyCards()).slice(0, 3);
const insights = (await insightCards()).slice(0, 3);

const serviceCards = services.map((s, i) => ({
  href: `/what-we-do#${s.id}`,
  title: s.title,
  tag: 'Service',
  summary: s.summary,
  seed: 3 + i * 2,
}));

const outcomes = [
  { value: '25.5%', label: 'Lower annual run cost', detail: 'Application consolidation, public sector.' },
  { value: '12 wk', label: 'To a fully staffed data team', detail: 'Resource augmentation, consumer goods.' },
  { value: '45%', label: 'Fewer priority-one incidents', detail: 'Operational risk, industrial manufacturing.' },
];
---

<BaseLayout>
  <PageHero
    tone="dark"
    scale="home"
    align="center"
    title="Next-gen consulting. Cutting-edge solutions. Driving enterprise goals to success"
    banner={['Next‑gen consulting.', 'Cutting‑edge solutions.', 'Driving enterprise goals to success']}
    lede="Technology consulting and talent resourcing for EU institutions and enterprises, from Zaventem, Belgium."
    primary={{ label: 'Find available engineers', href: '/talent' }}
    secondary={{ label: 'What we do', href: '/what-we-do' }}
  >
    <ClientLogos slot="footer" align="center" />
  </PageHero>

  {talent.length > 0 && (
    <FeatureBanner
      title="Senior engineers, analysts and delivery leads, ready to join your team."
      body="Profiles are anonymised. Request one to receive the full CV and arrange interviews."
      action={{ label: 'See the talent board', href: '/talent' }}
      figure={String(availableNow)}
      figureLabel="engineers available now"
    />
  )}

  <Section id="services" title="What we do" intro="Strategy, engineering and specialist talent under a single engagement, so advice and delivery stay accountable to the same outcome." viewAll={{ label: 'How each service works', href: '/what-we-do' }}>
    <CardGrid items={serviceCards} columns={4} label="Services" reveal />
  </Section>

  {work.length > 0 && (
    <Section id="work" title="Selected work" surface="fog" viewAll={{ label: 'All case studies', href: '/case-studies' }}>
      <CardGrid items={work} label="Case studies" />
    </Section>
  )}

  <Section id="evidence" title="Evidence, not adjectives" intro={logEntries.length > 0 ? 'Results from completed engagements, and a running log of work in progress.' : 'Results from completed engagements.'}>
    <MetricGrid metrics={outcomes} />
    {logEntries.length > 0 && (
      <div class="log-wrap">
        <Typography as="h3" variant="h3" class="log-title">Delivery log</Typography>
        <DeliveryLog entries={logEntries} />
      </div>
    )}
  </Section>

  {talent.length > 0 && (
    <Section id="talent" title="Available engineers" surface="fog" intro={`${availableNow} of ${talent.length} listed engineers can start now. Profiles are anonymised; request one to receive the full CV.`} viewAll={{ label: 'See the full talent board', href: '/talent' }}>
      <TalentBoard profiles={talent.slice(0, 3)} />
    </Section>
  )}

  {insights.length > 0 && (
    <Section id="insights" title="Latest insights" viewAll={{ label: 'View all', href: '/insights' }}>
      <CardGrid items={insights} label="Latest insights" />
    </Section>
  )}

  <HelpCta />
</BaseLayout>

<style>
  .log-wrap { margin-top: var(--space-8); }
  :global(.log-title) { margin-bottom: var(--space-5); }
</style>
