---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSplit from '@/components/blocks/HeroSplit.astro';
import Editorial from '@/components/blocks/Editorial.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import Typography from '@/components/ui/Typography.astro';
import Button from '@/components/ui/Button.astro';
import { consultingProcess, resourcingProcess } from '@/data/process';
import { getInsights, formatDate } from '@/lib/content';

const posts = await getInsights();
---

<BaseLayout title="Insights" description="How Winvigor runs consulting engagements and resourcing requests, step by step, plus articles from our consultants.">
  <HeroSplit
    title="How we work, step by step."
    lede="Our two core processes, each stage with what you receive at the end of it. Below them, articles from our consultants."
  />

  <nav class="toc" aria-label="On this page">
    <ul role="list">
      <li><a href="#consulting">Consulting engagements</a></li>
      <li><a href="#resourcing">Talent resourcing</a></li>
      <li><a href="#articles">Articles</a></li>
    </ul>
  </nav>

  <Editorial id="consulting" title="Consulting engagements" layout="stacked" intro="From first assessment to handover. Each stage ends with something your organisation keeps.">
    <ProcessSteps steps={consultingProcess} label="Consulting engagement process" />
    <div class="after">
      <Button href="/case-studies" variant="quiet">See this process in case studies</Button>
    </div>
  </Editorial>

  <Editorial id="resourcing" title="Talent resourcing" layout="stacked" surface="ink" intro="From a hiring brief to an engineer working inside your team.">
    <ProcessSteps steps={resourcingProcess} label="Talent resourcing process" inverse />
    <div class="after">
      <Button href="/talent" variant="primary" inverse>See available engineers</Button>
    </div>
  </Editorial>

  <Editorial id="articles" title="Articles" layout="stacked">
    {posts.length === 0 ? (
      <Typography variant="lead">New articles are on the way.</Typography>
    ) : (
      <ul role="list" class="post-list">
        {posts.map((p) => (
          <li class="post">
            <div class="post__meta">
              <Typography variant="meta"><time datetime={p.data.publishDate.toISOString()}>{formatDate(p.data.publishDate)}</time></Typography>
              {p.data.topics.length > 0 && <Typography variant="small" tone="muted">{p.data.topics.join(', ')}</Typography>}
              {p.data.sample && <span class="sample-tag">Sample</span>}
            </div>
            <div class="post__main">
              <Typography as="h3" variant="h3"><a href={`/insights/${p.id}`}>{p.data.title}</a></Typography>
              <Typography variant="body" tone="muted">{p.data.description}</Typography>
            </div>
          </li>
        ))}
      </ul>
    )}
  </Editorial>
</BaseLayout>

<style>
  .toc {
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-5) var(--gutter);
  }
  .toc ul { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin: 0; }
  .toc a { font-weight: 500; color: var(--graphite); text-decoration-color: var(--rule); }
  .toc a:hover { color: var(--ink); text-decoration-color: var(--accent); }

  .after { margin-top: var(--space-8); }

  .post-list { margin: 0; border-top: 1px solid var(--ink); }
  .post { display: grid; gap: var(--space-4); padding-block: var(--space-6); border-bottom: 1px solid var(--rule); }
  .post__meta { display: grid; gap: var(--space-2); justify-items: start; align-content: start; }
  .post__main { display: grid; gap: var(--space-3); max-width: 46rem; }
  .post__main a { text-decoration: none; }
  .post__main a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }

  @media (min-width: 64rem) {
    .post { grid-template-columns: 3fr 9fr; gap: clamp(1rem, 2.5vw, 2rem); }
  }
</style>
