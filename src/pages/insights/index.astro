---
/**
 * Insights: the knowledge hub. Modelled on Huxley's knowledge hub: title and
 * intro → featured banner → search and category filters → card grid of
 * articles and case studies → processes → "How can we help?".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import FeatureBanner from '@/components/blocks/FeatureBanner.astro';
import Section from '@/components/blocks/Section.astro';
import CardGrid from '@/components/blocks/CardGrid.astro';
import FilterBar from '@/components/blocks/FilterBar.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import HelpCta from '@/components/blocks/HelpCta.astro';
import Button from '@/components/ui/Button.astro';
import Typography from '@/components/ui/Typography.astro';
import { consultingProcess, resourcingProcess } from '@/data/process';
import { caseStudyCards, insightCards, INSIGHT_TAG, CASE_TAG } from '@/lib/content';

const items = [...(await insightCards()), ...(await caseStudyCards())];
const categories = [INSIGHT_TAG, CASE_TAG].filter((c) => items.some((i) => i.tag === c));
---

<BaseLayout title="Insights" description="Industry insights, case studies and advice from Winvigor's consultants, plus how our consulting and resourcing processes run, step by step.">
  <PageHero
    eyebrow="Knowledge hub"
    title="Insights"
    lede="Explore industry insights, case studies and advice from across technology consulting and talent resourcing for EU institutions and enterprises."
  />

  <FeatureBanner
    title="How we work, step by step."
    body="Our consulting and resourcing processes, with what you receive at the end of every stage."
    action={{ label: 'See our processes', href: '#processes' }}
    seed={15}
  />

  <Section id="articles" title="Recent articles and case studies">
    {items.length === 0 ? (
      <Typography variant="lead">New articles are on the way.</Typography>
    ) : (
      <>
        <FilterBar categories={categories} label="Filter insights" />
        <CardGrid items={items} label="Articles and case studies" />
      </>
    )}
  </Section>

  <Section id="processes" title="Consulting engagements" surface="fog" intro="From first assessment to handover. Each stage ends with something your organisation keeps.">
    <ProcessSteps steps={consultingProcess} label="Consulting engagement process" />
    <div class="after">
      <Button href="/case-studies" variant="secondary">See this process in case studies</Button>
    </div>
  </Section>

  <Section id="resourcing" title="Talent resourcing" intro="From a hiring brief to an engineer working inside your team.">
    <ProcessSteps steps={resourcingProcess} label="Talent resourcing process" />
    <div class="after">
      <Button href="/talent" variant="primary">See available engineers</Button>
    </div>
  </Section>

  <HelpCta />
</BaseLayout>

<style>
  .after { margin-top: var(--space-8); }
</style>
