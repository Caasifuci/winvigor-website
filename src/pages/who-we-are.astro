---
/**
 * Who we are, on the knowledge-hub pattern: hero → featured banner (mission)
 * → story → how we work as cards → clients → latest insights → help.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import FeatureBanner from '@/components/blocks/FeatureBanner.astro';
import Section from '@/components/blocks/Section.astro';
import CardGrid from '@/components/blocks/CardGrid.astro';
import HelpCta from '@/components/blocks/HelpCta.astro';
import ClientLogos from '@/components/blocks/ClientLogos.astro';
import LayersArt from '@/components/visuals/LayersArt.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
import { insightCards } from '@/lib/content';

const principles = [
  {
    icon: 'layers',
    title: 'Advice and delivery under one roof',
    body: 'The consultants who set the roadmap stay accountable for delivering it, alongside the engineers who build it.',
  },
  {
    icon: 'handshake',
    title: 'Plans that fit the organisation',
    body: 'Recommendations are shaped by your contracts, governance and people. A plan your board cannot approve is not a plan.',
  },
  {
    icon: 'chart',
    title: 'Outcomes agreed up front',
    body: 'Every engagement starts with measurable targets and ends with a review against them.',
  },
] as const;

const insights = (await insightCards()).slice(0, 3);
const { street, postalCode, locality, country } = site.contact.address;
---

<BaseLayout title="Who we are" description="Winvigor Solutions is a technology consulting and talent resourcing firm based in Zaventem, Belgium, working with EU institutions and enterprises.">
  <PageHero
    tone="dark"
    eyebrow="Who we are"
    title="Consultants and engineers, accountable for the same outcome."
    lede="Winvigor Solutions is a technology consulting and talent resourcing firm based in Zaventem, on the edge of Brussels. We work with leadership teams to streamline operations, reduce delivery risk and staff critical programmes."
  >
    <LayersArt slot="visual" />
  </PageHero>

  <FeatureBanner
    title="To help enterprises build operational excellence and sustainable growth through technology consulting and talent resourcing."
    body="Our mission. We strengthen our clients' own capabilities, so what we build keeps working after we leave."
    action={{ label: 'See how we work', href: '/insights#processes' }}
    seed={12}
  />

  <Section id="story" title="Our story">
    <div class="story">
      <p class="story__lead">
        Winvigor was founded on a simple observation: technology programmes go wrong when the people advising on them are not accountable for delivering them.
      </p>
      <p>
        We combine three things most organisations buy separately: strategic IT consulting, software delivery and specialist talent. Our clients include EU institutions, systems integrators such as Capgemini and Atos, and industrial and consumer-goods enterprises including Dresser-Rand and Reckitt.
      </p>
    </div>
  </Section>

  <Section id="how" title="How we work" surface="fog" viewAll={{ label: 'Our process step by step', href: '/insights#processes' }}>
    <ul role="list" class="principles">
      {principles.map((p) => (
        <li class="principle">
          <span class="principle__icon"><Icon name={p.icon} size={26} /></span>
          <h3 class="principle__title">{p.title}</h3>
          <p class="principle__body">{p.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="clients" compact>
    <ClientLogos />
  </Section>

  <Section id="office" title="Our office" surface="fog" compact>
    <div class="office">
      <span class="office__icon"><Icon name="pin" size={26} /></span>
      <address>
        {site.name}<br />
        {street}, {postalCode} {locality}, {country}
      </address>
    </div>
  </Section>

  {insights.length > 0 && (
    <Section id="insights" title="Latest insights" viewAll={{ label: 'View all', href: '/insights' }}>
      <CardGrid items={insights} label="Latest insights" />
    </Section>
  )}

  <HelpCta />
</BaseLayout>

<style>
  .story { display: grid; gap: var(--space-5); max-width: 46rem; font-size: 1.125rem; line-height: 1.7; color: var(--graphite); }
  .story__lead { font-family: var(--display); font-size: var(--step-2); font-weight: 500; line-height: 1.3; color: var(--ink); }

  .principles { display: grid; gap: clamp(1rem, 2.5vw, 1.75rem); margin: 0; }
  .principle {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--paper);
  }
  .principle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .principle__title { font-family: var(--display); font-size: var(--step-1); font-weight: 600; line-height: 1.25; color: var(--ink); }
  .principle__body { color: var(--slate); }

  .office { display: flex; align-items: flex-start; gap: var(--space-4); }
  .office__icon { display: inline-flex; color: var(--accent-strong); margin-top: 0.15rem; }
  .office address { font-style: normal; font-size: var(--step-1); line-height: 1.5; color: var(--ink); }

  @media (min-width: 52rem) { .principles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
