---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import Section from '@/components/blocks/Section.astro';
import NumberedSteps from '@/components/blocks/NumberedSteps.astro';
import CardGrid from '@/components/blocks/CardGrid.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import { insightCards } from '@/lib/content';
import Typography from '@/components/ui/Typography.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/data/site';

const { email, phone, phoneHref, address, formEndpoint } = site.contact;
const usesMailClient = !formEndpoint;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const insights = (await insightCards()).slice(0, 3);
---

<BaseLayout title="Contact" description={`Contact ${site.name} about technology consulting and talent resourcing. ${address.street}, ${address.postalCode} ${address.locality}.`}>
  <PageHero
    tone="dark"
    eyebrow="Contact"
    title="Tell us about your programme or hiring need."
    lede="Strategic advice, a delivery team or a specialist engineer: tell us what you need and how to reach you."
    primary={{ label: 'Send an enquiry', href: '#enquiry' }}
    features={[
      { icon: 'strategy', title: 'Strategic IT consulting', body: 'Roadmaps your organisation can fund, staff and deliver.', href: '/what-we-do#strategic-it-consulting' },
      { icon: 'people', title: 'Specialist engineers', body: 'Senior talent placed into your teams, contract or permanent.', href: '/talent' },
      { icon: 'code', title: 'Software delivery', body: 'Maintainable systems built around how you work.', href: '/what-we-do#custom-software-development' },
    ]}
  />

  <Container grid class="contact">
    <div class="form-head">
      <h2 class="form-head__title">Send us a message</h2>
      <p class="form-head__body">All fields except organisation are required. A consultant will come back to you.</p>
    </div>
    <form
      id="enquiry"
      class="form"
      action={formEndpoint ?? `mailto:${email}`}
      method="post"
      enctype={usesMailClient ? 'text/plain' : undefined}
    >
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="email">Work email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="organisation">Organisation <span class="optional">(optional)</span></label>
        <input id="organisation" name="organisation" type="text" autocomplete="organization" />
      </div>
      <input type="hidden" name="profile" id="profile" />
      {/* Honeypot: hidden from people, filled in by bots. */}
      <div class="hp" aria-hidden="true" hidden>
        <label for="website">Leave this field empty</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="field">
        <label for="message">How can we help?</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>
      <div class="consent">
        <input id="consent" name="consent" type="checkbox" value="yes" required />
        <label for="consent">
          I agree that {site.name} uses my details to respond to this enquiry, as described in the{' '}
          <a href="/privacy">privacy notice</a>.
        </label>
      </div>
      {turnstileKey && !usesMailClient && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>}
      <p class="form__status" role="alert" data-status hidden></p>
      <div class="form__actions">
        <Button type="submit" variant="primary" size="lg">Send enquiry</Button>
        {usesMailClient && (
          <Typography variant="small" tone="muted">This opens your email app with the message ready to send.</Typography>
        )}
      </div>
    </form>

    <aside class="details" aria-label="Contact details">
      <div class="detail">
        <span class="detail__icon"><Icon name="mail" size={22} /></span>
        <div>
          <Typography as="h2" variant="meta">Email</Typography>
          <p><a href={`mailto:${email}`}>{email}</a></p>
        </div>
      </div>
      <div class="detail">
        <span class="detail__icon"><Icon name="phone" size={22} /></span>
        <div>
          <Typography as="h2" variant="meta">Phone</Typography>
          <p><a href={phoneHref}>{phone}</a></p>
        </div>
      </div>
      <div class="detail">
        <span class="detail__icon"><Icon name="pin" size={22} /></span>
        <div>
          <Typography as="h2" variant="meta">Office</Typography>
          <address>
            {address.street}<br />
            {address.postalCode} {address.locality}<br />
            {address.country}
          </address>
        </div>
      </div>
    </aside>
  </Container>

  <Section id="next" title="What happens next" surface="fog">
    <NumberedSteps
      label="What happens after you get in touch"
      steps={[
        { title: 'Tell us what you need', body: 'The programme, the role or the problem, in as much detail as you have.' },
        { title: 'A consultant comes back to you', body: 'Someone who works in your area reads your message and arranges a first conversation.' },
        { title: 'We agree the next step', body: 'An assessment, a shortlist of profiles or a proposal, sized to what you actually need.' },
      ]}
    />
  </Section>

  {insights.length > 0 && (
    <Section id="insights" title="Latest insights" viewAll={{ label: 'View all', href: '/insights' }}>
      <CardGrid items={insights} label="Latest insights" />
    </Section>
  )}
</BaseLayout>

{turnstileKey && !usesMailClient && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Error states returned by the enquiry endpoint (?status=…)
  const statusMessages: Record<string, string> = {
    invalid: 'Please add your name, a valid email address and a message, tick the privacy notice box, then send again.',
    limit: 'Too many messages from this connection in the last hour. Please email us directly instead.',
    verify: 'The security check did not complete. Please try again.',
  };
  const status = new URLSearchParams(location.search).get('status');
  const statusEl = document.querySelector<HTMLElement>('[data-status]');
  if (status && statusEl && statusMessages[status]) {
    statusEl.textContent = statusMessages[status];
    statusEl.hidden = false;
  }

  // Prefill from the talent board: /contact?profile=WV-1234 or ?profile=brief
  const ref = new URLSearchParams(location.search).get('profile');
  const message = document.querySelector<HTMLTextAreaElement>('#message');
  const hidden = document.querySelector<HTMLInputElement>('#profile');
  if (ref && message && !message.value) {
    if (/^WV-\d{4}$/.test(ref)) {
      hidden!.value = ref;
      message.value = `I would like to receive the full profile for ${ref}.\n\nRole and team: \nStart date: \nDuration: `;
    } else if (ref === 'brief') {
      message.value = 'Hiring brief\n\nRole: \nKey skills: \nStart date: \nDuration: \nLocation or remote: \nSecurity clearance required (if any): ';
    }
  }
</script>

<style>
  :global(.contact) { padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem); row-gap: var(--space-7); }

  .form-head { grid-column: 1 / -1; display: grid; gap: var(--space-3); }
  .form-head__title { font-family: var(--display); font-size: var(--step-3); font-weight: 600; line-height: 1.12; color: var(--ink); }
  .form-head__body { color: var(--slate); }

  .form {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--paper);
    box-shadow: var(--shadow-card);
  }
  .field { display: grid; gap: var(--space-2); }
  label { font-weight: 500; color: var(--ink); }
  .optional { font-weight: 400; color: var(--slate); }

  input, textarea {
    width: 100%;
    padding: 0.8rem 0;
    border: 0;
    border-bottom: 1px solid var(--slate);
    border-radius: 0;
    background: transparent;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink);
  }
  textarea { resize: vertical; min-height: 8rem; }
  input, textarea { transition: border-color var(--dur-fast) var(--ease-standard), box-shadow var(--dur-base) var(--ease-out-expo); }
  input:focus, textarea:focus { outline: none; border-bottom-color: var(--accent); box-shadow: 0 1px 0 0 var(--accent); }
  input:focus-visible, textarea:focus-visible { outline: none; }

  .consent { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .consent input { width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; padding: 0; accent-color: var(--ink); }
  .consent label { font-weight: 400; color: var(--graphite); line-height: 1.5; }
  .consent a { color: var(--ink); text-decoration-color: var(--accent); text-decoration-thickness: 2px; }

  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form__status { padding: var(--space-3) var(--space-4); border-left: 2px solid var(--ink); background: var(--fog); color: var(--ink); }
  .form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-5); margin-top: var(--space-3); }

  .details { grid-column: 1 / -1; display: grid; gap: var(--space-4); align-content: start; }
  .detail {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--fog);
  }
  .detail__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .details p, .details address { margin-top: var(--space-1); font-size: 1.0625rem; overflow-wrap: anywhere; font-style: normal; color: var(--ink); line-height: 1.45; }
  .details a { text-decoration-color: var(--accent); text-decoration-thickness: 2px; }

  @media (min-width: 64rem) {
    .form { grid-column: 1 / span 7; }
    .details { grid-column: 9 / -1; }
  }
</style>
