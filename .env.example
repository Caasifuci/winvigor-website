# Copy to .env for local development. In Cloudflare Pages, set these under
# Settings > Environment variables (Production and Preview).

# "wordpress" reads content from the CMS; omit for the local sample files.
CONTENT_SOURCE=wordpress
WP_API_URL=https://cms.winvigor.com/wp-json
# Optional authenticated reads (WordPress > Users > Profile > Application passwords)
WP_API_USER=
WP_API_APP_PASSWORD=

# Contact form posts here (the Winvigor Headless plugin endpoint)
PUBLIC_FORM_ENDPOINT=https://cms.winvigor.com/wp-json/winvigor/v1/enquiry
# Optional Cloudflare Turnstile site key (secret goes in wp-config as WV_TURNSTILE_SECRET)
PUBLIC_TURNSTILE_SITE_KEY=

# Set to false before launch to hide everything marked as sample content
PUBLIC_SHOW_SAMPLES=true
